    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3",
    "express": "^4.21.2",
    "@larksuiteoapi/node-sdk": "^1.40.0",
    "pngjs": "^7.0.0"
